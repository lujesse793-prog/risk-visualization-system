{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "financial_analysis.schema.json",
  "title": "Skill4FinancialAnalysisOutput",
  "type": "object",
  "required": ["analysis_status"],
  "properties": {
    "analysis_status": {"type": "string", "enum": ["success", "partial", "failed"]},
    "data_status": {"type": "string"},
    "main_period": {"type": "string"},
    "periods_analyzed": {"type": "array", "items": {"type": "string"}},
    "financial_indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "indicator_name": {"type": "string"},
          "indicator_category": {"type": "string"},
          "period": {"type": "string"},
          "value": {"type": ["number", "string", "null"]},
          "unit": {"type": "string"},
          "formula": {"type": "string"},
          "input_fields": {"type": "array", "items": {"type": "object"}},
          "source_refs": {"type": "array", "items": {"type": "object"}},
          "status": {"type": "string"},
          "confidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "negative_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {"type": "string"},
          "finding_type": {"type": "string"},
          "risk_level": {"type": "string"},
          "indicator_name": {"type": "string"},
          "period": {"type": "string"},
          "value": {"type": ["number", "string", "null"]},
          "threshold": {"type": ["number", "string", "null"]},
          "judgement": {"type": "string"},
          "evidence_text": {"type": "string"},
          "source_document_id": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "object"}},
          "confidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "unavailable_indicators": {"type": "array", "items": {"type": "object"}},
    "analysis_summary": {"type": "object"},
    "frontend_financial_summary": {"type": "object"},
    "risk_level_summary": {"type": "object"},
    "validation_result": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
