{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "final_json.schema.json",
  "title": "PostLoanFinalJson",
  "type": "object",
  "required": ["task_id", "enterprise_name", "task_status", "data_status", "progress_events", "validation_result"],
  "properties": {
    "task_id": {"type": "string"},
    "enterprise_name": {"type": "string"},
    "task_status": {"type": "string", "enum": ["completed", "partial", "failed"]},
    "data_status": {
      "type": "string",
      "enum": [
        "success",
        "success_with_data_limitation",
        "no_latest_public_data",
        "search_failed",
        "pdf_parse_failed",
        "data_insufficient",
        "financial_extraction_failed",
        "financial_analysis_failed",
        "failed"
      ]
    },
    "message": {"type": "string"},
    "source_documents": {"type": "array", "items": {"$ref": "source_document.schema.json"}},
    "search_log": {"type": "array"},
    "freshness_gate": {"type": "object"},
    "data_availability": {"type": "object"},
    "pdf_handoff_summary": {
      "type": "object",
      "properties": {
        "task_id": {"type": "string"},
        "enterprise_name": {"type": "string"},
        "generated_at": {"type": "string"},
        "no_latest_public_data": {"type": "boolean"},
        "message": {"type": "string"},
        "documents_needing_pdf_parse_count": {"type": "integer"},
        "document_ids": {"type": "array", "items": {"type": ["string", "null"]}}
      },
      "additionalProperties": true
    },
    "parsed_documents_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {"type": "string"},
          "file_type": {"type": "string"},
          "report_period": {"type": "string"},
          "parser_used": {"type": "string"},
          "ocr_used": {"type": "boolean"},
          "page_count": {"type": "integer"},
          "tables_found_count": {"type": "integer"},
          "parse_status": {"type": "string"},
          "parse_confidence": {"type": "string"},
          "parse_warnings": {"type": "array", "items": {"type": "string"}},
          "json_output_path": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "parse_summary": {"type": "object"},
    "financial_extraction": {"$ref": "structured_financial_data.schema.json"},
    "structured_financial_data": {"type": "object"},
    "field_evidence": {"type": "array", "items": {"type": "object"}},
    "missing_fields": {"type": "array", "items": {"type": ["string", "object"]}},
    "extraction_warnings": {"type": "array", "items": {"type": "object"}},
    "document_usage": {"type": "array", "items": {"type": "object"}},
    "financial_analysis": {"$ref": "financial_analysis.schema.json"},
    "financial_indicators": {"type": "array", "items": {"type": "object"}},
    "negative_findings": {"type": "array", "items": {"type": "object"}},
    "unavailable_indicators": {"type": "array", "items": {"type": "object"}},
    "analysis_summary": {"type": "object"},
    "frontend_financial_summary": {"type": "object"},
    "risk_level_summary": {"type": "object"},
    "failed_documents": {"type": "array", "items": {"type": "object"}},
    "progress_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event", "percent", "timestamp"],
        "properties": {
          "event": {"type": "string"},
          "percent": {"type": "number"},
          "message": {"type": "string"},
          "timestamp": {"type": "string"},
          "elapsed_ms": {"type": "number"},
          "detail": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "validation_result": {
      "type": "object",
      "required": ["passed"],
      "properties": {
        "passed": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
