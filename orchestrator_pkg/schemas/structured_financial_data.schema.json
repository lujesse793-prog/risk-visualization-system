{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "structured_financial_data.schema.json",
  "title": "Skill3FinancialExtractionOutput",
  "type": "object",
  "properties": {
    "enterprise_name": {"type": "string"},
    "extraction_status": {"type": "string", "enum": ["success", "partial", "failed"]},
    "data_periods": {"type": "array", "items": {"type": "string"}},
    "selected_main_document_id": {"type": ["string", "null"]},
    "selected_supplement_document_ids": {"type": "array", "items": {"type": "string"}},
    "structured_financial_data": {
      "type": "object",
      "properties": {
        "financial_tables": {
          "type": "object",
          "properties": {
            "balance_sheet": {"type": "array", "items": {"type": "object"}},
            "income_statement": {"type": "array", "items": {"type": "object"}},
            "cash_flow_statement": {"type": "array", "items": {"type": "object"}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "field_evidence": {"type": "array", "items": {"type": "object"}},
    "missing_fields": {"type": "array", "items": {"type": ["string", "object"]}},
    "extraction_warnings": {"type": "array", "items": {"type": "object"}},
    "document_usage": {"type": "array", "items": {"type": "object"}},
    "validation_result": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "errors": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
