{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "structured_financial_data.schema.json",
  "title": "StructuredFinancialData",
  "description": "Skill 3 财务字段提取输出：结构化的财务数据",
  "type": "object",
  "required": ["enterprise_name", "source_document_id"],
  "properties": {
    "enterprise_name": {
      "type": "string"
    },
    "source_document_id": {
      "type": "string",
      "description": "主要分析来源文档ID"
    },
    "extraction_status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "extraction_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "data_periods": {
      "type": "array",
      "items": {"type": "string"},
      "description": "可用的报告期列表"
    },
    "balance_sheet": {
      "type": "array",
      "description": "资产负债表数据",
      "items": {
        "type": "object",
        "properties": {
          "field_name": {"type": "string"},
          "values": {
            "type": "object",
            "description": "period -> cell data 映射",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {"type": "string"},
                "unit": {"type": "string"},
                "source_title": {"type": "string"},
                "source_url": {"type": "string"},
                "page": {"type": "string"},
                "table_name": {"type": "string"},
                "raw_text": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "income_statement": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_name": {"type": "string"},
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {"type": "string"},
                "unit": {"type": "string"},
                "source_title": {"type": "string"},
                "source_url": {"type": "string"},
                "page": {"type": "string"},
                "table_name": {"type": "string"},
                "raw_text": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "cash_flow_statement": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_name": {"type": "string"},
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {"type": "string"},
                "unit": {"type": "string"},
                "source_title": {"type": "string"},
                "source_url": {"type": "string"},
                "page": {"type": "string"},
                "table_name": {"type": "string"},
                "raw_text": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "business_segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "segment_name": {"type": "string"},
          "revenue": {"type": "string"},
          "revenue_ratio": {"type": "string"},
          "gross_margin": {"type": "string"},
          "yoy_change": {"type": "string"},
          "data_source": {"type": "string"}
        }
      }
    },
    "extraction_warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "missing_fields": {
      "type": "array",
      "items": {"type": "string"},
      "description": "无法提取的字段列表"
    }
  }
}
